EXTRACTION_TIMEOUT=90
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW=60
DOWNLOAD_TOKEN_TTL=600
HLS_DOWNLOAD_TIMEOUT=1800
ENVIRONMENT=development
